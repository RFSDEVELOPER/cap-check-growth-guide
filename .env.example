# Copy to .env for local work. Never commit the real .env.
# Lovable Cloud fills the Supabase values for you; set the rest in the project secrets.

# --- Supabase (public values, safe for the browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server only) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Credentials vault: any long random text (e.g. `openssl rand -base64 32`). Do not lose it:
#     without it the saved Mercado Pago / Melhor Envio tokens cannot be read again. ---
SETTINGS_ENCRYPTION_KEY=

# --- Public address of the site, no trailing slash. Fixes return and webhook URLs. ---
SITE_URL=https://ciacap.com.br

# --- Optional ---
# Contact e-mail sent to Melhor Envio in the User-Agent header.
SHIPPING_CONTACT_EMAIL=contato@ciacap.com.br
# Fallbacks when the tokens are not saved in /admin/configuracoes.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
